# --- Smart Campus Management System — example environment ---
# Copy to `.env` and replace placeholders. NEVER commit real secrets.

# Local demo database (Prisma). Postgres example shown for parity:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/smart_campus?schema=public"
DATABASE_URL="file:./dev.db"

# Session lifetimes (minutes)
SESSION_IDLE_MINUTES="60"
SESSION_ABSOLUTE_MINUTES="480"

# Signs stateless session cookies on serverless hosts (Vercel). Locally sessions
# are stored in SQLite and this value is not used. On Vercel, leave it empty to
# use the per-deployment secret generated by scripts/prepare-vercel.mjs, or set a
# long random value to keep sessions valid across deployments.
SESSION_SECRET=""

# Show the demo credentials panel in production deployments (demo only).
SHOW_DEMO_ACCOUNTS="false"

# Attendance flag threshold (percent)
ATTENDANCE_THRESHOLD_PERCENT="75"

# Optional integrations (leave blank to use in-app notifications only)
SMTP_URL=""
SMS_PROVIDER_KEY=""

# --- AI assistant (server-only; never exposed to the browser) ----------------
# LLM_API_KEY is the ONLY required value for the assistant's LLM features.
# Provider defaults to Groq; override these to change provider/model without
# touching the assistant UI. Do not prefix any of these with NEXT_PUBLIC_.
LLM_API_KEY=""
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-120b"
# LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_TIMEOUT_MS="15000"
